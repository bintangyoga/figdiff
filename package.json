{
  "name": "figdiff",
  "version": "0.1.0-alpha.9",
  "description": "Review FigCraft design changes like code: semantic and visual diffs for .figcraft files.",
  "author": "bintangyoga",
  "license": "MIT",
  "type": "module",
  "bin": {
    "figdiff": "dist/cli.js",
    "figdiff-action": "dist/action.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "check:site": "node scripts/site-smoke.mjs",
    "preview:site": "npx --yes serve site/dist",
    "lint": "eslint src test scripts",
    "format": "prettier --write src test scripts \"site/src/**/*.{js,css}\"",
    "format:check": "prettier --check src test scripts \"site/src/**/*.{js,css}\"",
    "test:site": "node scripts/site-e2e.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bintangyoga/figdiff.git"
  },
  "bugs": {
    "url": "https://github.com/bintangyoga/figdiff/issues"
  },
  "homepage": "https://github.com/bintangyoga/figdiff#readme",
  "keywords": [
    "figcraft",
    "design",
    "diff",
    "github-action",
    "design-systems"
  ],
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "playwright": "^1.48.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0"
  }
}
